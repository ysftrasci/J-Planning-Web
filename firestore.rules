rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidAssignedTaskData(data) {
      return data.title is string &&
        data.title.size() > 0 && data.title.size() <= 300 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000)) &&
        data.priority in ['HIGH', 'MEDIUM', 'LOW', 'ZERO'] &&
        data.period in ['DAILY', 'WEEKLY', 'MONTHLY', 'ONCE'] &&
        data.subtaskCount is int && data.subtaskCount >= 1 && data.subtaskCount <= 100;
    }

    function isValidAssignedRewardData(data) {
      return data.title is string &&
        data.title.size() > 0 && data.title.size() <= 300 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000)) &&
        data.cost is int && data.cost >= 0 && data.cost <= 100000;
    }

    function isValidTaskDeletionNoticeData(data) {
      return data.taskTitle is string &&
        data.taskTitle.size() > 0 && data.taskTitle.size() <= 300 &&
        data.deletedByName is string &&
        data.deletedByName.size() > 0 && data.deletedByName.size() <= 100 &&
        data.assignedByUid is string &&
        data.deletedByUid is string;
    }

    // Atama yalnızca kabul edilmiş bir arkadaşlık üzerinden yapılabilir.
    // Arkadaşlık doküman kimlikleri rastgele olduğu için istemci kimliği atamayla birlikte gönderir.
    function isAcceptedFriendship(friendshipId, uidA, uidB) {
      let f = get(/databases/$(database)/documents/friendships/$(friendshipId)).data;
      return f.status == 'ACCEPTED' &&
        ((f.fromUid == uidA && f.toUid == uidB) || (f.fromUid == uidB && f.toUid == uidA));
    }

    function isNotAnonymous() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.admin == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDisabled', 'disabledAt', 'updatedAt', 'userCode']))
      );

      // Cihazlar arası senkronizasyon alanı için eklenen tek kısım:
      match /user_backup/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /userCodes/{code} {
      // Yalnızca TEK kod sorgulanabilir (get). Liste (list) kapalıdır: aksi halde giriş yapan
      // herkes tüm kullanıcıların kimlik, ad ve fotoğraf dökümünü alabilirdi.
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow create: if request.auth != null && isNotAnonymous() && (request.resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow update: if request.auth != null && isNotAnonymous() && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
    }

    match /friendships/{friendshipId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      // İstek yalnızca PENDING olarak oluşturulabilir (doğrudan ACCEPTED yazılamaz) ve
      // kişi kendine istek gönderemez.
      allow create: if request.auth != null && isNotAnonymous() &&
        request.auth.uid == request.resource.data.fromUid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'PENDING';
      // Kabul işlemini SADECE isteği ALAN kişi yapabilir; yalnızca status alanı,
      // yalnızca PENDING -> ACCEPTED yönünde değişebilir.
      allow update: if request.auth != null && isNotAnonymous() &&
        request.auth.uid == resource.data.toUid &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status == 'ACCEPTED' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    match /assignedTasks/{taskId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.assignedByUid || request.auth.uid == resource.data.assignedToUid);
      allow create: if request.auth != null && isNotAnonymous() &&
        request.auth.uid == request.resource.data.assignedByUid &&
        request.resource.data.assignedToUid is string &&
        request.resource.data.friendshipId is string &&
        isAcceptedFriendship(request.resource.data.friendshipId, request.auth.uid, request.resource.data.assignedToUid) &&
        isValidAssignedTaskData(request.resource.data);
      allow update: if request.auth != null && isNotAnonymous() &&
        (request.auth.uid == resource.data.assignedByUid || request.auth.uid == resource.data.assignedToUid) &&
        request.resource.data.assignedByUid == resource.data.assignedByUid &&
        request.resource.data.assignedToUid == resource.data.assignedToUid &&
        isValidAssignedTaskData(request.resource.data);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.assignedByUid || request.auth.uid == resource.data.assignedToUid);
    }

    match /assignedRewards/{rewardId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.assignedByUid || request.auth.uid == resource.data.assignedToUid);
      allow create: if request.auth != null && isNotAnonymous() &&
        request.auth.uid == request.resource.data.assignedByUid &&
        request.resource.data.assignedToUid is string &&
        request.resource.data.friendshipId is string &&
        isAcceptedFriendship(request.resource.data.friendshipId, request.auth.uid, request.resource.data.assignedToUid) &&
        isValidAssignedRewardData(request.resource.data);
      allow update: if request.auth != null && isNotAnonymous() &&
        (request.auth.uid == resource.data.assignedByUid || request.auth.uid == resource.data.assignedToUid) &&
        request.resource.data.assignedByUid == resource.data.assignedByUid &&
        request.resource.data.assignedToUid == resource.data.assignedToUid &&
        isValidAssignedRewardData(request.resource.data);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.assignedByUid || request.auth.uid == resource.data.assignedToUid);
    }

    match /taskDeletionNotices/{noticeId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.assignedByUid;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.deletedByUid &&
        request.resource.data.assignedByUid is string &&
        request.resource.data.assignedByUid != request.auth.uid &&
        isValidTaskDeletionNoticeData(request.resource.data);
    }
  }
}

